# ──────── PetCare backend env ────────
#
# Copy to `backend/.env` for local dev, or to `.env.prod` (at repo root, next
# to docker-compose.yml) on the EC2 host for production.
#
# Anything not listed has no env hook — `core/config.py` is the authoritative
# list of what the backend actually reads.


# ═══ Required ════════════════════════════════════════════════════════════
# The backend crashes at startup or stays unusable until each of these is set.

# JWT secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# A missing or placeholder value crashes the lifespan (intentional — fail loud).
JWT_SECRET_KEY=

# PostgreSQL DSN. Local example: postgresql://localhost:5432/petcare
# EC2 example:  postgresql://petcare:<pw>@host.docker.internal:5432/petcare
POSTGRES_URI=

# Apple Sign-In — the iOS app's bundle identifier (becomes the JWT `aud`).
# Must match what's set on the Apple Developer "Sign in with Apple" capability.
# Leave blank only if you don't intend to enable Apple sign-in.
APPLE_BUNDLE_ID=dting0918.PetCare

# Google Sign-In — the iOS client ID from Google Cloud Console / Info.plist.
# Leave blank only if you don't intend to enable Google sign-in.
GOOGLE_IOS_CLIENT_ID=

# Cloudinary (pet / food / user avatar uploads). All three required together;
# any photo endpoint returns 500 "not configured" if any is blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ═══ Optional ════════════════════════════════════════════════════════════
# Everything below has a sensible default in code. Uncomment + set only when
# the default doesn't fit (e.g. you want a different log level in prod, or
# CORS to be tighter than "*"). Otherwise leave them out entirely.

# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
# CORS_ORIGINS=*

# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional second Google audience (e.g. a web client) tried in addition to
# GOOGLE_IOS_CLIENT_ID. Most setups don't need this.
# GOOGLE_WEB_CLIENT_ID=

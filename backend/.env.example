# PetCare backend env starter template.
# Copy this file to backend/.env and fill in real values for local development.
# Production / staging values live in GitHub Secrets and Render env vars.
#
# This file does NOT enumerate every variable the backend understands — only
# the ones that have no sensible default and must be provided per environment.
# Add new placeholders here whenever a feature requires a new env var.

# Cloudinary (image storage for user, pet, and food photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
